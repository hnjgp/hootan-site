# Copy to .env and fill in. Never commit .env.

APP_ENV=development
SECRET_KEY=
TZ=Asia/Tehran
SITE_URL=http://localhost:3000

# Database
POSTGRES_USER=hootan
POSTGRES_PASSWORD=
POSTGRES_DB=hootan_site
# Used from Windows (pytest, alembic). Inside docker, compose overrides the host with "db".
DATABASE_URL=postgresql+asyncpg://hootan:PASSWORD@127.0.0.1:5432/hootan_site

# LLM (AvalAI, OpenAI-compatible)
LLM_BASE_URL=
LLM_API_KEY=
MODEL_TWIN=gemini-2.5-flash-lite
MODEL_JOBFIT=gemini-2.5-flash-lite
MODEL_TRADING=gpt-5-nano
MODEL_TRANSLATE=gpt-5-nano
MODEL_EMBED=text-embedding-3-small

# Budget guard (USD)
BUDGET_MONTHLY_USD=5
BUDGET_TRADING_DAILY_USD=0.06
BUDGET_PUBLIC_DAILY_USD=0.10
AI_ENABLED=true

# Market data
PRICE_SOURCE=

# Contact and admin
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ADMIN_TOKEN=
